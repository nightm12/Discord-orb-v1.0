DISCORD_TOKEN=put_your_bot_token_in_Railway_variables
# Optional: comma-separated server IDs for instant slash-command registration during setup.
DISCORD_GUILD_IDS=
QUEST_API_URL=https://api.discordquest.com/api/quests
POLL_SECONDS=300
# Railway Volume mount path; mount a volume at /app/data for persistent config and deduplication.
CONFIG_PATH=data/config.json
SEEN_PATH=data/seen.json
